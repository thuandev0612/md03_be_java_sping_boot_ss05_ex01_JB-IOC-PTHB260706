                  "pm.test('Error is wrapped', function () { const body=pm.response.json(); pm.expect(body.success).to.eql(false); pm.expect(body.data).to.eql(null); pm.expect(body.message).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
